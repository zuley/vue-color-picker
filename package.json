{
  "name": "vcolorpicker",
  "version": "2.2.0",
  "type": "module",
  "description": "基于 Vue3 的颜色选择器",
  "main": "./lib/vcolorpicker.umd.cjs",
  "module": "./lib/vcolorpicker.js",
  "types": "./index.d.ts",
  "files": [
    "lib/vcolorpicker.css",
    "lib/vcolorpicker.js",
    "lib/vcolorpicker.umd.cjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/vcolorpicker.js",
      "require": "./lib/vcolorpicker.umd.cjs"
    },
    "./style.css": "./lib/vcolorpicker.css",
    "./package.json": "./package.json"
  },
  "unpkg": "./lib/vcolorpicker.umd.cjs",
  "jsdelivr": "./lib/vcolorpicker.umd.cjs",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "vcolorpicker",
    "colorpicker",
    "color-picker",
    "vue-color-picker",
    "vue",
    "vue3"
  ],
  "author": "zuley",
  "license": "MIT",
  "homepage": "https://vue-color-picker.rxshc.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuley/vue-color-picker.git"
  },
  "bugs": {
    "url": "https://github.com/zuley/vue-color-picker/issues"
  },
  "private": false,
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "run-s type-check lib",
    "lib": "vite build --mode lib",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write packages/ docs/",
    "commit": "git-cz",
    "release": "release-it",
    "prepublishOnly": "run-s type-check test lib",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/server-renderer": "^3.5.34",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.0",
    "git-cz": "^4.9.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "sass": "^1.99.0",
    "typescript": "~5.8.3",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.33",
    "vue-tsc": "^3.2.7"
  },
  "release-it": {
    "github": {
      "release": false
    },
    "git": {
      "commitMessage": "release: v${version}"
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": "echo 更新版本成功"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  }
}
